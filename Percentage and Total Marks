#include<stdio.h>
int main()
{
    int a,b,c,d,e,total,percentage;
    printf("Enter the marks of each subject=");
    scanf("%d %d %d %d %d",&a,&b,&c,&d,&e);
    total=(a+b+c+d+e);
    percentage=(total*100)/500;
    printf("The total marks obtained by student is %d \n",total);
    printf("percentage of marks obtained by student is %d",percentage);
    return 0;
}   
