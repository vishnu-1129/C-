#include <stdio.h>
int main() {
    int N;
    if (scanf("%d", &N) != 1) return 0;
    int arr[50];
    int max_contiguous = 0;
    int current_contiguous = 0;
    for (int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] % 2 == 0) {
            current_contiguous++;
            if (current_contiguous > max_contiguous) {
                max_contiguous = current_contiguous;
            }
        } else {
            current_contiguous = 0;
        }
    }
    printf("%d", max_contiguous);
    return 0;
}
